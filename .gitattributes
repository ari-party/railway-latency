# Normalize text files to CRLF in the working tree on checkout.
* text=auto eol=crlf

# Cargo always writes LF lockfiles.
Cargo.lock text eol=lf

# Husky hook scripts must stay LF or sh chokes on the CR.
.husky/** text eol=lf

# The bootstrap template is piped to bash on the probe VPS; CR breaks it.
apps/control-plane/src/templates/bootstrap.sh.ejs text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary
*.pdf binary
