# Normalize text files to CRLF in the working tree on checkout.
* text=auto eol=crlf

# Cargo always writes LF lockfiles.
Cargo.lock text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary
*.pdf binary
