{
  "name": "@railway-latency/utils",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "gen:cities": "node scripts/gen-cities.mjs",
    "typecheck": "tsc --noEmit",
    "eslint": "eslint .",
    "lint": "pnpm run typecheck && pnpm run eslint",
    "lint:fix": "pnpm run eslint --fix",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@railway-latency/eslint-config": "workspace:*",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "csv-parse": "^7.0.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.3",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@railway-latency/types": "workspace:*",
    "zod": "^4.1.12"
  },
  "sideEffects": false
}
